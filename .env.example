# REDHOPE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your Supabase credentials

# 1. Supabase Project Settings (from https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Service Role Key (Keep private! Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Application URL (used for redirects, meta tags, and open graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
